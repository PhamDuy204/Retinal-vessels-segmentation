    "class MultiScopeLoss(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        pass\n",
    "    def forward(self,pred,truth):\n",
    "        b = truth.shape[0]\n",
    "        pred = pred.squeeze(1).float()\n",
    "        truth = truth.squeeze(1).float()\n",
    "        loss=torch.zeros(1).to(pred.device)\n",
    "        for i,wl in [(3,0.5),(5,0.3),(7,0.2)]:\n",
