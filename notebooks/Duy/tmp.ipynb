   "source": [
    "import torch\n",
    "from pytorch_wavelets import DWTForward\n",
    "\n",
    "# Dummy input tensor (batch=1, channel=1, H=64, W=64)\n",
    "x = torch.rand(1, 1, 64, 64) \n",
    "\n",
    "# Khởi tạo wavelet transform\n",
    "# J=1 -> số level, wave='haar' hoặc 'db1', 'db2',...\n",
    "dwt = DWTForward(J=1, wave='haar')\n",
    "\n",
    "# Áp dụng DWT\n",
    "Yl, Yh = dwt(x)  \n",
    "\n",
    "# Yl: low frequency (approximation coefficients)\n",
    "# Yh: high frequency (detail coefficients) list\n",
    "print(\"Low frequency shape:\", Yl.shape)\n",
    "print(\"High frequency shape:\", Yh[0].sum(2).shape)\n",
    "\n",
    "# Lấy riêng low frequency\n",
    "low_freq = Yl\n"
   ]
  },
